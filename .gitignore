# Ignora i byte-compiled Python
__pycache__/
*.py[cod]
*$py.class

# (Opzionale) altri file che di solito non vuoi versionare
*.log
*.sqlite3
*.env
.envrc
# Ignora tutti gli xlsx, xls e csv
*.xlsx
*.xls
*.csv

# Build / distribution
build/
dist/
*.egg-info/

# Eventuali exe / dll / log generati
__pycache__/
*.exe
*.dll
*.log
